{
    "name": "svextensions/module-dynamic-label",
    "description": "Allows Magento 2 admin users to override any frontend text/label globally from the admin panel without modifying CSV files or templates.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "proprietary",
    "authors": [
        {
            "name": "SV Extensions",
            "email": "satishmv26@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "magento/framework": ">=103.0",
        "magento/module-backend": ">=102.0",
        "magento/module-store": ">=101.0",
        "magento/module-ui": ">=101.0",
        "magento/module-config": ">=101.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "SVExtensions\\DynamicLabel\\": ""
        }
    },
    "extra": {
        "map": [
            [
                "*",
                "SVExtensions/DynamicLabel"
            ]
        ]
    }
}
