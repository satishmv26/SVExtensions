<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <referenceContainer name="before.body.end">

            <block class="SVExtensions\DynamicLabel\Block\Esi"
                   name="dynamic.label.esi"
                   ttl="86400"
                   cacheable="true"/>

            <block class="SVExtensions\DynamicLabel\Block\Js"
                   name="dynamic.label.js"
                   template="SVExtensions_DynamicLabel::js.phtml"/>

        </referenceContainer>
    </body>

</page>