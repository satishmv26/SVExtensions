<?php if ($block->isEnabled()): ?>
<script>
(function () {

    function normalize(text) {
        return String(text || '')
            .replace(/\u00a0/g, ' ')
            .replace(/[\n\r\t]/g, ' ')
            .replace(/\s+/g, ' ')
            .replace(/[:\-–—]+$/, '')
            .trim()
            .toLowerCase();
    }

   function apply(map) {
        if (!map) return;

        const elements = document.querySelectorAll(
            'button, a, label, .action, .product-item-link'
        );

        for (let i = 0; i < elements.length; i++) {
            const el = elements[i];

            // skip complex nodes
            if (el.children.length > 0) continue;

            let text = normalize(el.textContent);

            if (map[text]) {
                el.textContent = map[text];
            }
        }
    }

    function run(map) {
        if ('requestIdleCallback' in window) {
            requestIdleCallback(() => apply(map));
        } else {
            setTimeout(() => apply(map), 50);
        }
    }

    if (window.dynamicLabelMap) {
        run(window.dynamicLabelMap);
        return;
    }

    fetch('<?= $block->getUrl("dynamiclabel/index/index") ?>', {
        cache: 'force-cache'
    })
    .then(res => res.json())
    .then(map => run(map))
    .catch(() => {});

})();
</script>
<?php endif; ?>